# Copy this file to ".env" to change a setting. Everything has a working default.

# Password for the SQL Server "sa" account. Needs upper + lower case, a digit and a symbol, 8+ chars.
# SA_PASSWORD=RaceDay_Passw0rd!

# Use real Azure Blob Storage instead of the local Azurite container.
# BLOB_PUBLIC_BASE_URL=            <- also set this line, left empty, when using real Azure
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
