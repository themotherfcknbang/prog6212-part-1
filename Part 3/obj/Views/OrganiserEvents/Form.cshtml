@model EventFormViewModel
@{
    var isEdit = Model.EventID.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}

<p><a asp-action="Index">&larr; My events</a></p>
<h1 class="rd-title">@ViewData["Title"]</h1>

<div class="rd-card p-4">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="EventID" />
        <input type="hidden" asp-for="ExistingBannerUrl" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" min="@(isEdit ? null : DateTime.Today.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Tell runners what makes this event special."></textarea>
            </div>
            <div class="col-12">
                <label asp-for="RouteDescription" class="form-label"></label>
                <textarea asp-for="RouteDescription" class="form-control" rows="3"
                          placeholder="Where does it start, where does it go, where does it finish?"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ExistingBannerUrl" alt="Current banner" class="rd-detail-banner" style="max-height: 160px; width: auto;" />
                        <div class="form-text">Current banner. Choose a new image to replace it.</div>
                    </div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">JPEG, PNG or WebP, up to 5 MB. It is shown on the event cards and the event page.</div>
                <span asp-validation-for="Banner" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-rd mt-4">@(isEdit ? "Save changes" : "Create event")</button>
        <a asp-action="Index" class="btn btn-link mt-4">Cancel</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
