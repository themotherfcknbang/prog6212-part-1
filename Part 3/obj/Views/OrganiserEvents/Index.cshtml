@using System.Globalization
@model List<EventSummary>
@{
    ViewData["Title"] = "My events";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="rd-title mb-0">My events</h1>
        <p class="text-muted mb-0">Create, edit and manage the events you organise.</p>
    </div>
    <a asp-action="Create" class="btn btn-rd">+ Create event</a>
</div>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
else if (Model.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <h2>No events yet</h2>
        <p class="text-muted">Create your first event and start taking entries.</p>
        <a asp-action="Create" class="btn btn-rd">Create event</a>
    </div>
}
else
{
    <div class="rd-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr><th></th><th>Event</th><th>Date</th><th>Location</th><th>Distances</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var isPast = e.EventDate < today;
                        <tr>
                            <td style="width: 90px">
                                @if (!string.IsNullOrEmpty(e.BannerUrl))
                                {
                                    <img src="@e.BannerUrl" alt="" class="rd-thumb" />
                                }
                                else
                                {
                                    <div class="rd-thumb-empty"></div>
                                }
                            </td>
                            <td>
                                <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventID"><strong>@e.EventName</strong></a>
                            </td>
                            <td>
                                @e.EventDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                                <div><span class="status-badge @(isPast ? "status-dns" : "status-confirmed")">@(isPast ? "Past" : "Upcoming")</span></div>
                            </td>
                            <td>@e.Location</td>
                            <td>@e.CategoryCount</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-rd">Manage</a>
                                <a asp-action="Edit" asp-route-id="@e.EventID" class="btn btn-sm btn-outline-rd">Edit</a>
                                <form asp-action="Delete" asp-route-id="@e.EventID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
