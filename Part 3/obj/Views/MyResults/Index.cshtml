@using System.Globalization
@model List<ResultInfo>
@{ ViewData["Title"] = "My results"; }

<h1 class="rd-title">My results</h1>
<p class="text-muted">Your finish times and positions from every race you've completed.</p>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
else if (Model.Count == 0)
{
    <div class="rd-card p-5 text-center">
        <h2>No results yet</h2>
        <p class="text-muted">Once an organiser publishes the results of an event you entered, they'll appear here.</p>
        <a asp-controller="MyEnrolments" asp-action="Index" class="btn btn-rd">See my enrolments</a>
    </div>
}
else
{
    <div class="rd-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Distance</th>
                        <th>Finish time</th>
                        <th>Position</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventID"><strong>@r.EventName</strong></a>
                            </td>
                            <td>@r.EventDate.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            <td>@r.CategoryName (@r.DistanceKM.ToString("0.##") km)</td>
                            <td>
                                @if (r.Status == "Finished" && r.FinishTime.HasValue)
                                {
                                    <span class="rd-time">@r.FinishTime.Value.ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (r.Status == "Finished" && r.Position.HasValue)
                                {
                                    <span class="rd-position">@Formatting.Ordinal(r.Position.Value)</span>
                                    @if (r.TotalFinishers.HasValue)
                                    {
                                        <span class="rd-meta"> of @r.TotalFinishers</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><span class="status-badge status-@r.Status.ToLower()">@Formatting.StatusLabel(r.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
