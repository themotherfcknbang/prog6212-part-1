@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="rd-card p-4 text-center">
            <h1 class="rd-title">Something went wrong</h1>
            <p class="text-muted">We hit a problem loading that page. It's on our side, not yours. Please try again.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Back to events</a>
            @if (Model?.ShowRequestId == true)
            {
                <p class="rd-meta mt-3 mb-0">Reference: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>
